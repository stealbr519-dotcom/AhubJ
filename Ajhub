-- ============================================================
-- Config persistence (Delta file I/O with folder argument fix)
-- ============================================================
local CONFIG_STORE = {}
local CONFIG_FOLDER = "AhubJ_Configs"

local function ensureFolder()
    pcall(function()
        if makefolder then
            makefolder(CONFIG_FOLDER)
        end
    end)
end

local function configPath(name)
    return CONFIG_FOLDER .. "/" .. name .. ".json"
end

local function deepCopy(t)
    if type(t) ~= "table" then return t end
    local c = {}
    for k, v in pairs(t) do c[k] = deepCopy(v) end
    return c
end

local function tryWriteFile(name, data)
    pcall(function()
        if writefile then
            ensureFolder()
            writefile(configPath(name), data)
        end
    end)
end

local function tryReadFile(name)
    local ok, data = pcall(function()
        if readfile then
            return readfile(configPath(name))
        end
    end)
    if ok and data then return data end
    return nil
end

local function tryListFiles()
    local out = {}
    pcall(function()
        if listfiles then
            ensureFolder()
            for _, f in ipairs(listfiles(CONFIG_FOLDER)) do
                local n = f:match("([^/\\]+)%.json$")
                if n then table.insert(out, n) end
            end
        end
    end)
    return out
end

local function tryDeleteFile(name)
    pcall(function()
        if delfile then
            delfile(configPath(name))
        end
    end)
end

