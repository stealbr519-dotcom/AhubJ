do
    configRefs.getState = function()
        local state = {
            walkSpeed = 16,
            jumpPower = 50,
            flySpeed  = 50,

            espEnabled   = ESP.enabled,
            espBox       = ESP.box,
            espLines     = ESP.lines,
            espName      = ESP.name,
            espDist      = ESP.dist,
            espUsernames = ESP.usernames,
            espChams     = ESP.chams,
            espGlow      = ESP.glow,
            espChamColor = toHex(ESP.chamColor),
            espMaxDist   = ESP.maxDist,

            noclip = noclipEnabled,

            checkpoints = {},
        }

        if playerPage and playerPage:FindFirstChild("WalkSpeedBox") then
            state.walkSpeed = playerPage.WalkSpeedBox.Text
        end
        if playerPage and playerPage:FindFirstChild("JumpPowerBox") then
            state.jumpPower = playerPage.JumpPowerBox.Text
        end
        if playerPage and playerPage:FindFirstChild("FlySpeedBox") then
            state.flySpeed = playerPage.FlySpeedBox.Text
        end

        for _, e in ipairs(checkpoints) do
            table.insert(state.checkpoints, {
                name = e.name,
                cf = { e.pos.X, e.pos.Y, e.pos.Z,
                       e.pos:ToEulerAnglesXYZ() },
            })
        end

        return state
    end

    configRefs.setState = function(data)
        if type(data) ~= "table" then return end

        if playerPage then
            if data.walkSpeed and playerPage:FindFirstChild("WalkSpeedBox") then
                playerPage.WalkSpeedBox.Text = tostring(data.walkSpeed)
            end
            if data.jumpPower and playerPage:FindFirstChild("JumpPowerBox") then
                playerPage.JumpPowerBox.Text = tostring(data.jumpPower)
            end
            if data.flySpeed and playerPage:FindFirstChild("FlySpeedBox") then
                playerPage.FlySpeedBox.Text = tostring(data.flySpeed)
            end
        end

        local char = LocalPlayer.Character
        local h = char and char:FindFirstChildOfClass("Humanoid")
        if h then
            if tonumber(data.walkSpeed) then h.WalkSpeed = tonumber(data.walkSpeed) end
            if tonumber(data.jumpPower) then
                h.UseJumpPower = true
                h.JumpPower = tonumber(data.jumpPower)
            end
        end

        if data.espBox       ~= nil then ESP.box       = data.espBox       end
        if data.espLines     ~= nil then ESP.lines     = data.espLines     end
        if data.espName      ~= nil then ESP.name      = data.espName      end
        if data.espDist      ~= nil then ESP.dist      = data.espDist      end
        if data.espUsernames ~= nil then ESP.usernames = data.espUsernames end
        if data.espChams     ~= nil then ESP.chams     = data.espChams     end
        if data.espGlow      ~= nil then ESP.glow      = data.espGlow      end
        if data.espMaxDist   ~= nil then ESP.maxDist   = data.espMaxDist   end

        if data.espChamColor then
            local c = parseHex(data.espChamColor)
            if c then ESP.chamColor = c end
        end

        if data.espEnabled ~= nil then
            if data.espEnabled and not ESP.enabled then
                espStart()
            elseif not data.espEnabled and ESP.enabled then
                espStop()
            end
        end

        if data.noclip ~= nil and data.noclip ~= noclipEnabled then
            toggleNoclip()
        end

        if type(data.checkpoints) == "table" then
            for i = #checkpoints, 1, -1 do
                if checkpoints[i] and checkpoints[i].row then
                    checkpoints[i].row:Destroy()
                end
                table.remove(checkpoints, i)
            end
            cpCount = 0

            for _, entry in ipairs(data.checkpoints) do
                if entry.cf then
                    local pos = CFrame.new(entry.cf[1], entry.cf[2], entry.cf[3])
                        * CFrame.Angles(entry.cf[4] or 0, entry.cf[5] or 0, entry.cf[6] or 0)
                    makeCheckpointRow(entry.name, pos)
                end
            end
        end
    end
end

