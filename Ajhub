local function toHex(c)
    return string.format("%02X%02X%02X",
        math.floor(c.R * 255 + 0.5),
        math.floor(c.G * 255 + 0.5),
        math.floor(c.B * 255 + 0.5))
end

local function parseHex(str)
    str = str:gsub("#", ""):upper()
    if #str == 6 and str:match("^%x+$") then
        return Color3.fromRGB(
            tonumber(str:sub(1, 2), 16),
            tonumber(str:sub(3, 4), 16),
            tonumber(str:sub(5, 6), 16))
    end
    return nil
end

local function espValid(plr)
    if plr == LocalPlayer then return false end
    local char = plr.Character
    if not char then return false end
    if not char:FindFirstChild("HumanoidRootPart") then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    return true
end

local function applyVisual(plr)
    local o = espObjects[plr]
    if not o then return end
    local char = plr.Character
    if not char then return end

    if ESP.chams or ESP.glow then
        if not o.highlight or o.highlight.Parent ~= char then
            if o.highlight then o.highlight:Destroy() end
            local hl = Instance.new("Highlight")
            hl.Parent = char
            o.highlight = hl
        end
        o.highlight.FillColor   = ESP.chamColor
        o.highlight.OutlineColor = ESP.chamColor
        o.highlight.FillTransparency = ESP.glow and 0.2 or 0.5
        o.highlight.OutlineTransparency = 0
        o.highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    elseif o.highlight then
        o.highlight:Destroy()
        o.highlight = nil
    end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if ESP.glow and hrp then
        if not o.light or o.light.Parent ~= hrp then
            if o.light then o.light:Destroy() end
            local pl = Instance.new("PointLight")
            pl.Range = 18
            pl.Brightness = 3
            pl.Parent = hrp
            o.light = pl
        end
        o.light.Color = ESP.chamColor
    elseif o.light then
        o.light:Destroy()
        o.light = nil
    end
end

local function refreshVisuals()
    for plr in pairs(espObjects) do
        applyVisual(plr)
    end
end

local function espCreate(plr)
    if espObjects[plr] then return end

    local box = Drawing.new("Square")
    box.Thickness    = 1
    box.Filled       = false
    box.Transparency = 1
    box.Color        = Color3.fromRGB(0, 255, 100)
    box.Visible      = false

    local line = Drawing.new("Line")
    line.Thickness    = 1
    line.Transparency = 1
    line.Color        = ESP.chamColor
    line.Visible      = false

    local nameTag = Drawing.new("Text")
    nameTag.Size    = 14
    nameTag.Center  = true
    nameTag.Outline = true
    nameTag.Color   = Color3.new(1, 1, 1)
    nameTag.Visible = false

    local distTag = Drawing.new("Text")
    distTag.Size    = 13
    distTag.Center  = true
    distTag.Outline = true
    distTag.Color   = Color3.fromRGB(255, 255, 0)
    distTag.Visible = false

    espObjects[plr] = { box = box, line = line, name = nameTag, dist = distTag }
    applyVisual(plr)
end

local function espRemove(plr)
    local o = espObjects[plr]
    if not o then return end
    for _, d in pairs(o) do
        if typeof(d) == "userdata" or typeof(d) == "table" then
            pcall(function() d:Destroy() end)
            pcall(function() d:Remove() end)
        end
    end
    if o.highlight then pcall(function() o.highlight:Destroy() end) end
    if o.light then pcall(function() o.light:Destroy() end) end
    espObjects[plr] = nil
end

local function espStart()
    if ESP.enabled then return end
    if not Drawing then
        warn("[AhubJ] Drawing API unavailable — ESP needs an executor with Drawing support.")
        return
    end

    ESP.enabled = true
    espObjects = {}

    for _, p in ipairs(Players:GetPlayers()) do
        espCreate(p)
    end

    if espAdded then espAdded:Disconnect() end
    if espRemoving then espRemoving:Disconnect() end
    if espRender then espRender:Disconnect() end
    if espCharacterConn then espCharacterConn:Disconnect() end

    espAdded = Players.PlayerAdded:Connect(function(p)
        p.CharacterAdded:Connect(function()
            task.wait(0.2)
            if not ESP.enabled then return end
            espRemove(p)
            espCreate(p)
        end)
        espCreate(p)
    end)

    espRemoving = Players.PlayerRemoving:Connect(espRemove)

    espRender = RunService.RenderStepped:Connect(function()
        local cam = workspace.CurrentCamera
        if not cam then return end
        local vp = cam.ViewportSize
        local bottom = Vector2.new(vp.X / 2, vp.Y)

        for plr, o in pairs(espObjects) do
            if espValid(plr) then
                local hrp = plr.Character.HumanoidRootPart
                local pos, onScreen = cam:WorldToViewportPoint(hrp.Position)
                local distance = (cam.CFrame.Position - hrp.Position).Magnitude
                local show = onScreen and distance <= ESP.maxDist

                if show then
                    local scale  = 1 / (pos.Z * math.tan(math.rad(cam.FieldOfView * 0.5))) * 1000
                    local height = math.clamp(scale * 3.2, 20, 600)
                    local width  = height * 0.55

                    o.box.Size     = Vector2.new(width, height)
                    o.box.Position = Vector2.new(pos.X - width / 2, pos.Y - height / 2)
                    o.box.Visible  = ESP.box

                    o.name.Text     = ESP.usernames and plr.Name or plr.DisplayName
                    o.name.Position = Vector2.new(pos.X, pos.Y - height / 2 - 16)
                    o.name.Visible  = ESP.name

                    o.dist.Text     = string.format("[%d studs]", math.floor(distance))
                    o.dist.Position = Vector2.new(pos.X, pos.Y + height / 2 + 2)
                    o.dist.Visible  = ESP.dist

                    o.line.From    = bottom
                    o.line.To      = Vector2.new(pos.X, pos.Y + height / 2)
                    o.line.Color   = ESP.chamColor
                    o.line.Visible = ESP.lines
                else
                    o.box.Visible, o.name.Visible, o.dist.Visible, o.line.Visible = false, false, false, false
                end
            else
                o.box.Visible, o.name.Visible, o.dist.Visible, o.line.Visible = false, false, false, false
            end
        end
    end)

    espCharacterConn = LocalPlayer.CharacterAdded:Connect(function()
        task.wait(0.5)
        if not ESP.enabled then return end
        espStart()
    end)
end

local function espStop()
    ESP.enabled = false
    if espRender   then espRender:Disconnect()   espRender = nil end
    if espAdded    then espAdded:Disconnect()    espAdded = nil end
    if espRemoving then espRemoving:Disconnect() espRemoving = nil end
    if espCharacterConn then espCharacterConn:Disconnect() espCharacterConn = nil end
    for plr in pairs(espObjects) do
        espRemove(plr)
    end
    espObjects = {}
end

