local function flash(text, color)
    button.Text = text
    button.BackgroundColor3 = color
    task.delay(1.2, function()
        if button and button.Parent then
            button.Text = "TELEPORT!"
            button.BackgroundColor3 = Color3.fromRGB(0, 140, 255)
        end
    end)
end

-- Teleport logic
button.MouseButton1Click:Connect(function()
    local nums = {}
    for n in string.gmatch(box.Text, "-?%d*%.?%d+") do
        table.insert(nums, tonumber(n))
    end

    if #nums < 3 then
        flash("Enter X, Y, Z", Color3.fromRGB(200, 50, 50))
        return
    end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        flash("No character", Color3.fromRGB(200, 50, 50))
        return
    end

    hrp.CFrame = CFrame.new(nums[1], nums[2], nums[3])
    flash("Teleported!", Color3.fromRGB(40, 180, 80))
end)

-- Dragging (drag by the title area / empty frame space)
local dragging, dragStart, startPos
frame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)
